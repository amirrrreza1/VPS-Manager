# Caddy reverse proxy for VPS Manager.
#
# Caddy obtains and renews TLS automatically. Merge this site block into
# /etc/caddy/Caddyfile. The panel should NEVER be exposed over plain HTTP.

atlas.amirrrreza.ir {
	encode zstd gzip

	# The app sets its own security headers; these are the network-level
	# backstops in case the app is unreachable.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Streaming upload limit. Keep aligned with VPM_MAX_UPLOAD_BYTES.
	request_body {
		max_size 1GB
	}

	# Download URLs contain bearer tokens. Do not persist them in access logs.
	log_skip /api/shared/*

	# Matches the loopback port published by deploy/compose.yaml.
	# For the systemd example in README.md, use port 3000 instead.
	reverse_proxy 127.0.0.1:3090 {
		# Deploy logs stream over SSE; buffering would hold them until the
		# deploy finishes, which defeats the live log view.
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	log {
		output file /var/log/caddy/vps-manager.log
		format json
	}
}
