# Separate multiple roots with : on Linux/macOS or ; on Windows.
# On Windows, omit VPM_ROOTS for the local .dev-root sandbox.
VPM_ROOTS=/opt
VPM_DATA_DIR=./.vpm-data
# Use sudo only for a systemd install with deploy/vps-manager.sudoers.
# VPM_DOCKER_SUDO=1
VPM_SESSION_TTL_MS=43200000
VPM_MAX_EDIT_BYTES=2097152
# Defaults to VPM_DATA_DIR/files. Kept outside the public webroot.
# VPM_FILES_DIR=/var/lib/vps-manager/files
# 1 GiB per file; keep the Caddy request_body limit aligned.
VPM_MAX_UPLOAD_BYTES=1073741824
# Optional read-only VPS telemetry mounts for a container deployment.
# deploy/compose.yaml sets these automatically. Native Linux uses /proc.
# VPM_HOST_PROC=/host/proc
# VPM_HOST_SYS=/host/sys
# VPM_HOST_OS_RELEASE=/host/os-release
# VPM_HOST_HOSTNAME=/host/hostname
