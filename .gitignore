# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vps-manager local state
# The SQLite DB holds password hashes, TOTP secrets and session records.
/.vpm-data/
# Local sandbox used when developing off-target (VPM_ROOTS default on win32).
/.dev-root/
# Stray test output
/deploy-out.log
/.test-artifacts/
/output/playwright/
/.playwright-cli/
# Editor backups created by the Files API
*.bak
